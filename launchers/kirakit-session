#!/usr/bin/env bash
# kirakit-session NAME SETTINGS SCHEME [ARGS...]: start Claude Code as a team member, in a
# session named NAME with the settings SETTINGS (a JSON object, such as the output style, or
# the path of a settings file), pass ARGS through, and exit with Claude Code's status. In
# Konsole, the pane shows the color scheme SCHEME meanwhile, and gets the scheme of its
# profile back on exit, interruption included.
set -u

if [ $# -lt 3 ]; then
	printf 'usage: kirakit-session NAME SETTINGS SCHEME [ARGS...]\n' >&2
	exit 2
fi
name=$1
settings=$2
scheme=$3
shift 3

# Where the color sequences go: the terminal, even when the output is redirected.
tty=${KIRAKIT_TTY:-/dev/tty}

set_scheme() {
	printf '\033]50;ColorScheme=%s\a' "$1" >>"$tty" 2>/dev/null || true
}

# konsole_call OBJECT METHOD: call a method of this Konsole over D-Bus.
konsole_call() {
	local qdbus
	qdbus=$(command -v qdbus6 || command -v qdbus) || return 1
	"$qdbus" "${KONSOLE_DBUS_SERVICE-}" "$1" "$2" 2>/dev/null
}

# The color scheme of the Konsole profile in use, else Konsole's default one. Konsole 26.08
# answers an empty Session.profile(), hence the window's and the configured default profile.
profile_scheme() {
	local profile file found
	profile=$(konsole_call "$KONSOLE_DBUS_SESSION" org.kde.konsole.Session.profile)
	[ -n "$profile" ] || profile=$(konsole_call "${KONSOLE_DBUS_WINDOW-}" org.kde.konsole.Window.defaultProfile)
	if [ -z "$profile" ]; then
		profile=$(sed -n 's/^DefaultProfile=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/konsolerc" 2>/dev/null | head -n 1)
		profile=${profile%.profile}
	fi
	file=${XDG_DATA_HOME:-$HOME/.local/share}/konsole/$profile.profile
	if [ -n "$profile" ] && [ -f "$file" ]; then
		found=$(sed -n 's/^ColorScheme=//p' "$file" | head -n 1)
	fi
	printf '%s\n' "${found:-Breeze}"
}

if [ -n "${KONSOLE_DBUS_SESSION-}" ]; then
	previous=$(profile_scheme)
	trap 'set_scheme "$previous"' EXIT
	# Ctrl-C belongs to Claude Code; the shell only waits for it to end, then restores.
	trap : INT
	trap 'exit 129' HUP
	trap 'exit 143' TERM
	set_scheme "$scheme"
fi

claude -n "$name" --settings "$settings" "$@"
