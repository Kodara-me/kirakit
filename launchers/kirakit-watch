#!/usr/bin/env bash
# kirakit-watch ROLE [--once]: check GitHub as a team member's account and print one line per
# change that concerns her role, nothing otherwise. The lead's session runs one process per team
# account in the profile.
#
# ROLE is assistant, analyst or developer (coder is the same as developer). The member's
# account comes from the profile ($CLAUDE_CONFIG_DIR/.kirakit-profile, key ROLE_github), or
# from KIRAKIT_WATCH_ACCOUNT; the user's login from KIRAKIT_USER, else `gh config get user`.
# The check runs with the member's token (GH_TOKEN when set, else `gh auth token --user`).
#
# Sources:
#   - the account's notifications (participating threads), read with If-Modified-Since, so a
#     304 costs nothing, and paced by X-Poll-Interval: assignments, comments that wake the
#     member (the user's replies, see wake_items) and, for the assistant and the developer,
#     approving reviews of the pull requests the account wrote;
#   - the threads the member's account commented in that changed since the last check, because
#     GitHub does not notify an account of its own comments (a reply posted from her own
#     account would never show up in her notifications);
#   - for the assistant only (the lead's account, which every published specification and
#     task is assigned to), the specifications that enter Ready, and the issues with no
#     specification that enter a Ready column, on the boards of the user and of the owner of
#     each repository where an open issue is assigned to the assistant's account; a
#     specification on no board of its owner counts when labelled status:ready.
#     Tasks are not looked for: the next-task skill chooses the task.
#
# Each line is "KIND REPOSITORY#NUMBER URL". State lives in
# ${XDG_STATE_HOME:-~/.local/state}/kirakit/watch-ROLE, so a restart reports nothing twice.
# With --once, check a single time and exit (the fallback check); otherwise check every 120
# seconds, or less often when GitHub asks for it.
#
# One check per role at a time: a second continuous check exits at once with one line on
# standard error and status 1; --once while a check of the same role runs checks nothing,
# prints nothing and exits successfully. A continuous check started while a --once round runs
# waits for that round to end.
#
# For tests: KIRAKIT_WATCH_SLEEP replaces `sleep`; when it fails, the loop ends.
set -u

min_interval=120

usage() {
	printf 'usage: kirakit-watch ROLE [--once]   (ROLE: assistant, analyst or developer)\n' >&2
	exit 2
}

role=
once=
for arg in "$@"; do
	case $arg in
	--once) once=1 ;;
	-*) usage ;;
	*) [ -z "$role" ] || usage; role=$arg ;;
	esac
done
case $role in
assistant | analyst | developer) ;;
coder) role=developer ;;
*) usage ;;
esac

command -v jq >/dev/null 2>&1 || {
	printf 'kirakit-watch: jq is required\n' >&2
	exit 1
}

state=${XDG_STATE_HOME:-$HOME/.local/state}/kirakit/watch-$role
mkdir -p "$state" || exit 1

# Locks (R19): symbolic links named after the holder's process ID, created atomically by `ln`.
# watch.lock is held by the continuous check for its whole life, round.lock by every round, so
# that two rounds of a role never run at once. A lock whose holder is no longer a running
# kirakit-watch of the same role (killed, or its ID reused) is taken over.
# lock_live PID: whether PID is a running kirakit-watch of this role, other than this one.
lock_live() {
	local args word found=
	case $1 in '' | *[!0-9]*) return 1 ;; esac
	[ "$1" != "$$" ] || return 1
	kill -0 "$1" 2>/dev/null || return 1
	args=$(ps -p "$1" -o args= 2>/dev/null) || return 0
	[ -z "$args" ] && return 0
	# The role is the first word after the script that names a role (coder is developer).
	for word in $args; do
		if [ -z "$found" ]; then
			case $word in *kirakit-watch) found=1 ;; esac
			continue
		fi
		case $word in
		coder | developer) [ "$role" = developer ]; return ;;
		assistant | analyst) [ "$role" = "$word" ]; return ;;
		esac
	done
	return 1
}
# lock_holder LOCK: the process ID that holds LOCK, empty when none.
lock_holder() {
	readlink "$1" 2>/dev/null || true
}
# lock_take LOCK: take LOCK, or fail when a live check holds it. A stale lock is moved aside
# first, atomically, so that two processes that find it stale never both take it.
lock_take() {
	local holder moved aside
	ln -sn "$$" "$1" 2>/dev/null && return 0
	holder=$(lock_holder "$1")
	lock_live "$holder" && return 1
	aside=$1.stale.$$
	mv "$1" "$aside" 2>/dev/null || return 1
	moved=$(lock_holder "$aside")
	if [ "$moved" != "$holder" ]; then
		# Another process took the stale lock in between: give it back.
		ln -sn "$moved" "$1" 2>/dev/null
		rm -f "$aside"
		return 1
	fi
	rm -f "$aside"
	ln -sn "$$" "$1" 2>/dev/null
}
# lock_release LOCK: release LOCK when this process holds it.
lock_release() {
	[ "$(lock_holder "$1")" != "$$" ] || rm -f "$1"
}
sleeping=
release_locks() {
	[ -z "$sleeping" ] || kill "$sleeping" 2>/dev/null
	lock_release "$state/round.lock"
	lock_release "$state/watch.lock"
}
trap release_locks EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

if [ -n "$once" ]; then
	lock_live "$(lock_holder "$state/watch.lock")" && exit 0
	lock_take "$state/round.lock" || exit 0
elif ! lock_take "$state/watch.lock"; then
	printf 'kirakit-watch: a %s check is already running (process %s)\n' "$role" "$(lock_holder "$state/watch.lock")" >&2
	exit 1
fi

config_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
profile_key=$role
[ "$role" != developer ] || profile_key=coder
account=${KIRAKIT_WATCH_ACCOUNT-}
if [ -z "$account" ] && [ -f "$config_dir/.kirakit-profile" ]; then
	account=$(sed -n "s/^${profile_key}_github=//p" "$config_dir/.kirakit-profile" | head -n 1)
fi
[ -n "$account" ] || {
	printf 'kirakit-watch: no GitHub account for the %s (profile key %s_github)\n' "$role" "$profile_key" >&2
	exit 1
}
if [ -z "${GH_TOKEN-}" ]; then
	GH_TOKEN=$(gh auth token --user "$account") && [ -n "$GH_TOKEN" ] || {
		printf 'kirakit-watch: no token for %s\n' "$account" >&2
		exit 1
	}
	export GH_TOKEN
fi
user=${KIRAKIT_USER-}
[ -n "$user" ] || user=$(gh config get user -h github.com 2>/dev/null)
[ -n "$user" ] || {
	printf "kirakit-watch: the user's GitHub login is unknown (KIRAKIT_USER)\n" >&2
	exit 1
}

poll_interval=$min_interval
notifications_status=
first_round=
round_threads=

# The team accounts: the profile's three GitHub logins, plus KIRAKIT_WATCH_TEAM (space
# separated) for tests, and the member's own account.
team="$account"
for key in assistant_github analyst_github coder_github; do
	if [ -f "$config_dir/.kirakit-profile" ]; then
		login=$(sed -n "s/^${key}=//p" "$config_dir/.kirakit-profile" | head -n 1)
		[ -z "$login" ] || team="$team $login"
	fi
done
team="$team ${KIRAKIT_WATCH_TEAM-}"

# seen KEY: whether KEY was reported; remember KEY: record it.
seen() { grep -qxF -- "$1" "$state/seen" 2>/dev/null; }
remember() { printf '%s\n' "$1" >>"$state/seen"; }

# report KIND REPOSITORY NUMBER URL
report() {
	printf '%s %s#%s %s\n' "$1" "$2" "$3" "$4"
}

# api_get PATH: the headers and body of a GET, the status line first. A 304 makes gh fail, but
# still prints the response.
api_get() {
	local headers=()
	[ -z "${2-}" ] || headers=(-H "If-Modified-Since: $2")
	gh api -i ${headers[@]+"${headers[@]}"} "$1" 2>/dev/null
}

# each_item PATH: the elements of a (paginated) list of the API, one JSON per line.
each_item() {
	gh api --paginate "$1" 2>/dev/null | jq -c '.[]?' 2>/dev/null
}

# wake_items: read the normalized items of a thread (a JSON array, on stdin) and print
# "KIND ID URL" for each one that counts as the user's reply and is new. The rule (#38 R2, R3):
# a comment counts when its author is the user's account, or when its author is a team
# account, it carries no session marker (<!-- kirakit:ROLE -->), and it was posted after the
# latest comment carrying one in the same thread. An account outside the team never counts.
# Items have kind, id, login, body, at (a timestamp, possibly empty) and state, url. A review
# of a team account counts by its body only; an approval of the member's own pull request is
# check_approvals' business (OWN set). Items older than SINCE are skipped.
wake_items() {
	jq -r --arg user "$user" --arg team "$team" --arg since "$1" --arg own "$2" '
		def marked: (.body // "") | test("<!-- kirakit:(assistant|analyst|coder) -->");
		($team | split(" ") | map(select(. != ""))) as $members
		| ([.[] | select(marked) | .at // ""] | max // null) as $latest
		| .[]
		| (.login // "") as $login
		| select(($since == "" or (.at // "") == "" or .at >= $since)
			and ($own == "" or .kind != "review" or .state != "APPROVED")
			and (.kind != "review" or (.body // "") != ""
				or .state == "CHANGES_REQUESTED" or .state == "APPROVED")
			and ($login == $user
				or (($members | index($login)) != null and (marked | not)
					and (.kind != "review" or (.body // "") != "")
					and ($latest != null) and (.at // "") != "" and .at > $latest)))
		| "\(.kind) \(.id) \(.url)"'
}

# check_comments REPOSITORY NUMBER TYPE [OWN]: report the new comments of a thread that wake
# the member: the comments of the issue or pull request and, on a pull request, its review
# comments and the bodies of its reviews. OWN is set for a pull request of the member,
# whose approvals check_approvals reports instead. The whole thread is read, since the latest
# marked comment may be older than the last check.
check_comments() {
	local repo=$1 number=$2 type=$3 own=${4-} since items='' list kind id url
	since=$(cat "$state/since" 2>/dev/null || true)
	list=$(each_item "repos/$repo/issues/$number/comments" |
		jq -c '{kind: "comment", id, login: (.user.login // ""), body, at: (.created_at // ""), url: .html_url}')
	items=$list
	if [ "$type" = PullRequest ]; then
		list=$(each_item "repos/$repo/pulls/$number/comments" |
			jq -c '{kind: "review-comment", id, login: (.user.login // ""), body, at: (.created_at // ""), url: .html_url}')
		items+=$'\n'$list
		list=$(each_item "repos/$repo/pulls/$number/reviews" |
			jq -c 'select(.state != "PENDING") | {kind: "review", id, login: (.user.login // ""), body, state,
				at: (.submitted_at // ""), url: .html_url}')
		items+=$'\n'$list
	fi
	while read -r kind id url; do
		[ -n "$kind" ] || continue
		seen "$kind:$id" && continue
		remember "$kind:$id"
		report "$kind" "$repo" "$number" "$url"
	done < <(printf '%s\n' "$items" | sed '/^$/d' | jq -s '.' 2>/dev/null |
		wake_items "$since" "$own")
}

# check_approvals REPOSITORY NUMBER: report the new approving reviews of a pull request the
# member wrote (assistant and developer), those submitted since the last check: an approval
# older than the watch, or already reported and since forgotten, is not reported. It fails
# when the pull request is not hers.
check_approvals() {
	local repo=$1 number=$2 pr review key since
	since=$(cat "$state/since" 2>/dev/null || true)
	pr=$(gh pr view "https://github.com/$repo/pull/$number" --json number,url,author,reviews 2>/dev/null) || return 1
	[ "$(printf '%s' "$pr" | jq -r '.author.login // ""')" = "$account" ] || return 1
	printf '%s' "$pr" | jq -c --arg since "$since" '.reviews[]? | select(.state == "APPROVED"
		and ($since == "" or (.submittedAt // "") >= $since))' | while IFS= read -r review; do
		key=review:$(printf '%s' "$review" | jq -r '.id')
		seen "$key" && continue
		remember "$key"
		report approved "$repo" "$number" "$(printf '%s' "$pr" | jq -r '.url')"
	done
}

# check_assignment REPOSITORY NUMBER URL REASON UPDATED_AT: report the assignment of a thread
# once. The reason of a notification is that of its latest event, so a thread is looked at
# each time it changes: it may have been assigned before a later comment. On the first round
# (first_round set), an assignment is only remembered, as older comments are not read.
check_assignment() {
	local key=assigned:$1#$2 looked=looked:$1#$2:$5
	seen "$key" && return 0
	if [ "$4" != assign ]; then
		seen "$looked" && return 0
		remember "$looked"
		gh api "repos/$1/issues/$2" 2>/dev/null |
			jq -e --arg account "$account" '[.assignees[]?.login] | index($account)' >/dev/null 2>&1 || return 0
	fi
	remember "$key"
	[ -n "$first_round" ] || report assigned "$1" "$2" "$3"
}

# check_thread REPOSITORY NUMBER TYPE: the approvals (assistant and developer) and the
# comments of a thread, once per round.
check_thread() {
	local own=
	case " $round_threads " in *" $1#$2 "*) return 0 ;; esac
	round_threads+=" $1#$2"
	if [ "$role" != analyst ] && [ "$3" = PullRequest ]; then
		check_approvals "$1" "$2" && own=1
	fi
	check_comments "$1" "$2" "$3" "$own"
}

# check_own_threads: the threads the member's account commented in that changed since the last
# check. GitHub does not notify an account of its own comments, so a reply the user posts from
# the member's own account is found here instead of in the notifications. A failed search
# changes nothing and is tried again on the next check.
check_own_threads() {
	local since json repo number type
	since=$(cat "$state/since" 2>/dev/null || true)
	[ -n "$since" ] || return 0
	json=$(gh search issues --commenter "$account" --updated ">=$since" --limit 100 \
		--json repository,number,isPullRequest 2>/dev/null) || return 0
	while IFS=' ' read -r repo number type; do
		[ -n "$repo" ] || continue
		check_thread "$repo" "$number" "$type"
	done < <(printf '%s' "$json" | jq -r '.[]? | "\(.repository.nameWithOwner) \(.number) \(if .isPullRequest then "PullRequest" else "Issue" end)"' 2>/dev/null)
}

# check_notifications: read the notifications, honoring If-Modified-Since and X-Poll-Interval.
# It sets notifications_status, the HTTP status of the reply.
check_notifications() {
	local response modified interval body line repo number url reason type html updated own
	response=$(api_get 'notifications?participating=true&per_page=100' "$(cat "$state/modified" 2>/dev/null || true)")
	notifications_status=$(printf '%s\n' "$response" | sed -n '1s/^HTTP[^ ]* \([0-9]*\).*/\1/p')
	interval=$(printf '%s\n' "$response" | tr -d '\r' | sed -n 's/^[Xx]-[Pp]oll-[Ii]nterval: *//p' | head -n 1)
	case $interval in '' | *[!0-9]*) ;; *) poll_interval=$interval ;; esac
	[ "$poll_interval" -ge "$min_interval" ] || poll_interval=$min_interval
	[ "$notifications_status" = 200 ] || return 0
	modified=$(printf '%s\n' "$response" | tr -d '\r' | sed -n 's/^[Ll]ast-[Mm]odified: *//p' | head -n 1)
	body=$(printf '%s\n' "$response" | tr -d '\r' | sed '1,/^$/d')
	while IFS= read -r line; do
		repo=$(printf '%s' "$line" | jq -r '.repository.full_name')
		url=$(printf '%s' "$line" | jq -r '.subject.url')
		number=${url##*/}
		reason=$(printf '%s' "$line" | jq -r '.reason')
		type=$(printf '%s' "$line" | jq -r '.subject.type')
		updated=$(printf '%s' "$line" | jq -r '.updated_at // ""')
		case $type in Issue | PullRequest) ;; *) continue ;; esac
		html=https://github.com/$repo/$([ "$type" = PullRequest ] && echo pull || echo issues)/$number
		check_assignment "$repo" "$number" "$html" "$reason" "$updated"
		check_thread "$repo" "$number" "$type"
	done < <(printf '%s' "$body" | jq -c '.[]?' 2>/dev/null)
	[ -z "$modified" ] || printf '%s\n' "$modified" >"$state/modified"
}


# ready_items: the specifications in Ready, and the issues with no specification in a Ready
# column, one "REPOSITORY NUMBER URL" per line, sorted. The owners read are the user's login
# and the owner of every repository with an open issue assigned to the member (the
# assistant). On a board, a specification is an issue labelled type:feature; an issue with no
# parent has no specification. A specification on no board of its owner counts when labelled
# status:ready.
# It fails when a lookup fails, so that a partial list is never taken for the current one. An
# issue whose parent cannot be read is skipped, or kept when it was in the previous list, so
# that one unreadable item neither blocks the others nor comes back as new. Board items are
# not filtered by state, as in next-task: a closed specification left in Ready is reported.
ready_items() {
	local json owners owner boards board items boarded lines='' repo number url parent previous
	previous=$(cat "$state/ready" 2>/dev/null || true)
	json=$(gh search issues --assignee "$account" --state open --limit 1000 --json repository 2>/dev/null) || return 1
	owners=$(printf '%s' "$json" | jq -r '.[]?.repository.nameWithOwner | split("/")[0]' 2>/dev/null) || return 1
	owners=$(printf '%s\n%s\n' "$user" "$owners" | sed '/^$/d' | sort -u)
	for owner in $owners; do
		boarded=
		json=$(gh project list --owner "$owner" --format json 2>/dev/null) || return 1
		boards=$(printf '%s' "$json" | jq -r '.projects[]?.number' 2>/dev/null) || return 1
		for board in $boards; do
			items=$(gh project item-list "$board" --owner "$owner" --format json --limit 1000 2>/dev/null) || return 1
			boarded+=$'\n'$(printf '%s' "$items" | jq -r '.items[]? | select(.content.type == "Issue")
				| "\(.content.repository) \(.content.number)"' 2>/dev/null) || return 1
			lines+=$'\n'$(printf '%s' "$items" | jq -r '.items[]?
				| select(.status == "Ready" and .content.type == "Issue" and ((.labels // []) | index("type:feature")))
				| "\(.content.repository) \(.content.number) \(.content.url)"') || return 1
			while read -r repo number url; do
				[ -n "$repo" ] || continue
				if ! json=$(gh issue view "$number" --repo "$repo" --json parent 2>/dev/null) ||
					! parent=$(printf '%s' "$json" | jq -r '.parent.number // ""' 2>/dev/null); then
					printf '%s\n' "$previous" | grep -qxF -- "$repo $number $url" && lines+=$'\n'"$repo $number $url"
					continue
				fi
				[ -n "$parent" ] || lines+=$'\n'"$repo $number $url"
			done < <(printf '%s' "$items" | jq -r '.items[]?
				| select(.status == "Ready" and .content.type == "Issue" and (((.labels // []) | index("type:feature")) | not))
				| "\(.content.repository) \(.content.number) \(.content.url)"')
		done
		json=$(gh search issues --owner "$owner" --label type:feature --label status:ready --state open \
			--limit 1000 --json repository,number,url 2>/dev/null) || return 1
		while read -r repo number url; do
			[ -n "$repo" ] || continue
			printf '%s\n' "$boarded" | grep -qxF -- "$repo $number" && continue
			lines+=$'\n'"$repo $number $url"
		done < <(printf '%s' "$json" | jq -r '.[]? | "\(.repository.nameWithOwner) \(.number) \(.url)"' 2>/dev/null)
	done
	printf '%s\n' "$lines" | sed '/^$/d' | sort -u
}

# check_ready: report the specifications and the issues with no specification that entered
# Ready since the last check, including on the first one. One that leaves Ready is forgotten,
# so it is reported again if it comes back. When a lookup fails, the
# previous list is kept.
check_ready() {
	local current previous repo number url
	current=$(ready_items) || return 0
	previous=$(cat "$state/ready" 2>/dev/null || true)
	printf '%s\n' "$current" | while read -r repo number url; do
		[ -n "$repo" ] || continue
		printf '%s\n' "$previous" | grep -qxF -- "$repo $number $url" && continue
		report ready "$repo" "$number" "$url"
	done
	printf '%s\n' "$current" | sed '/^$/d' >"$state/ready"
}

# minute_ago: the UTC time a minute ago (GNU or BSD date), else now.
minute_ago() {
	date -u -d '1 minute ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
		date -u -v-1M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
		date -u +%Y-%m-%dT%H:%M:%SZ
}

# check: one round. The first one only starts the clock: comments, reviews and assignments
# older than the watch are not reported. Afterwards, `since` moves forward, with a margin of a minute for clocks that
# differ (an item seen twice is reported once), only when GitHub answered (200 or 304): after
# a failure the next round looks again from the last good one.
check() {
	local started
	started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	first_round=
	if [ ! -f "$state/since" ]; then
		first_round=1
		printf '%s\n' "$started" >"$state/since"
	fi
	round_threads=
	check_notifications
	check_own_threads
	[ "$role" != assistant ] || check_ready
	case $notifications_status in
	200 | 304) minute_ago >"$state/since" ;;
	esac
	# Keep the memory of what was reported bounded.
	if [ "$(wc -l <"$state/seen" 2>/dev/null || echo 0)" -gt 2000 ]; then
		tail -n 1000 "$state/seen" >"$state/seen.tmp" && mv "$state/seen.tmp" "$state/seen"
	fi
}

if [ -n "$once" ]; then
	check
	exit 0
fi
sleeper=${KIRAKIT_WATCH_SLEEP:-sleep}
while :; do
	# Wait for a --once round that runs, then hold the round for this check.
	until lock_take "$state/round.lock"; do sleep 1; done
	check
	lock_release "$state/round.lock"
	# In the background, so that a signal ends the check at once, with its locks.
	"$sleeper" "$poll_interval" &
	sleeping=$!
	wait "$sleeping" || exit 0
	sleeping=
done
