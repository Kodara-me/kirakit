#!/usr/bin/env bash
# team [DIR]: open a new Konsole window with one pane per team member, side by side, each
# running its member's launcher in DIR (default: the current directory).
#
# Konsole gets a layout file with a command per pane. Konsole ignores --workdir with --layout,
# so each pane enters DIR itself, and it refuses Session.runCommand over D-Bus unless its
# security-sensitive D-Bus API is enabled, hence no D-Bus.
set -u

members=(assistant)
{{#analyst}}
members+=(analyst)
{{/analyst}}

die() {
	printf 'team: %s\n' "$1" >&2
	exit 1
}

[ $# -le 1 ] || die 'usage: team [DIR]'
dir=${1:-$PWD}
[ -d "$dir" ] || die "not a directory: $dir"
dir=$(cd -- "$dir" && pwd) || die "cannot enter $dir"
bin=$(cd -- "$(dirname -- "$0")" && pwd) || die 'cannot find the launchers'
# Konsole splits each command like a POSIX shell; a backslash or a newline would need more
# than the quoting below.
case $dir$bin in
*\\* | *$'\n'*) die "cannot use a path with a backslash or a newline: $dir" ;;
esac
command -v konsole >/dev/null || die 'Konsole is not installed'

# quote STRING: STRING in single quotes. A loop rather than ${1//…}: bash 3.2 (macOS) reads
# the quotes of its replacement differently.
quote() {
	local rest=$1 out="'"
	while [[ $rest == *\'* ]]; do
		out+="${rest%%\'*}'\\''"
		rest=${rest#*\'}
	done
	printf "%s'" "$out$rest"
}

# json STRING: STRING as a JSON string; the paths hold no backslash or control character.
json() {
	printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"
}

layout_dir=$(mktemp -d "${TMPDIR:-/tmp}/kirakit-team.XXXXXX") || die 'cannot write the layout'
layout=$layout_dir/layout.json
{
	printf '{\n    "Orientation": "Horizontal",\n    "Widgets": [\n'
	for ((i = 0; i < ${#members[@]}; i++)); do
		command="sh -c 'cd -- \"\$1\" && exec \"\$2\"' team $(quote "$dir") $(quote "$bin/${members[i]}")"
		separator=,
		[ $((i + 1)) -lt ${#members[@]} ] || separator=
		printf '        { "SessionRestoreId": 0, "Command": %s }%s\n' "$(json "$command")" "$separator"
	done
	printf '    ]\n}\n'
} >"$layout" || die 'cannot write the layout'

konsole --separate --layout "$layout" >/dev/null 2>&1 &
# Konsole reads the layout as it starts.
(
	sleep 30
	rm -rf "$layout_dir"
) >/dev/null 2>&1 &
